 "food_notes": [
  {
   "level": "good",
   "title": "カロリー収支は目標範囲",
   "body": "平均収支は-704kcal/日（推定2.7kg/月）。目標の-770〜-513kcal/日に収まっています。ただし約500kcalを超える不足は筋量維持に不利になり得るため、下限側（−500前後）に寄せるのが筋トレ中は安全です。",
   "sources": [
    "hall2008",
    "murphy2022"
   ]
  },
  {
   "level": "info",
   "title": "消費カロリーは誤差を見込む",
   "body": "スマホやリングの消費カロリーは20%以上ずれることがあります。収支だけでなく、体重の週平均の推移（月2〜3kg減＝週0.5〜0.75kg）で答え合わせをしてください。",
   "sources": [
    "shcherbina2017"
   ]
  },
  {
   "level": "alert",
   "title": "たんぱく質不足（筋肉維持の最重要項目）",
   "body": "平均95g/日＝1.32g/kg。減量中の筋トレなら最低1.6g/kg（115g）、できれば2.0〜2.4g/kgを。鶏むね・卵・魚・ギリシャヨーグルト・プロテインで1食20〜40gを足してください。",
   "sources": [
    "morton2018",
    "longland2016",
    "jager2017"
   ]
  },
  {
   "level": "info",
   "title": "たんぱく質の配分",
   "body": "1食29g（0.4g/kg）以上を満たす食事が1日平均2.0回。3〜4回に分けると筋合成に有利です。朝食に卵2個＋ヨーグルト等を。",
   "sources": [
    "schoenfeld2018",
    "jager2017"
   ]
  },
  {
   "level": "info",
   "title": "食物繊維が不足",
   "body": "平均12g/日（目標21g以上）。野菜・海藻・きのこ・オートミール・豆類で満腹感も上がります。",
   "sources": [
    "mhlw_dri2020"
   ]
  },
  {
   "level": "info",
   "title": "アルコール",
   "body": "今週の純アルコール合計60g。1日20gを超えた日が0日。",
   "sources": [
    "mhlw_alcohol",
    "parr2014"
   ]
  }
 ],
 "exercise_notes": [
  {
   "level": "good",
   "title": "筋トレ頻度は良好",
   "body": "今週の筋トレは3日。減量中も重量（強度）を落とさないことが筋量維持の鍵です。",
   "sources": [
    "schoenfeld2016freq",
    "helms2014"
   ]
  },
  {
   "level": "info",
   "title": "週1回しか刺激していない部位",
   "body": "胸・肩・背中・脚・お尻・体幹は今週1回のみ。週2回に分けると同じ総セット数でも筋肥大に有利です。",
   "sources": [
    "schoenfeld2016freq"
   ]
  },
  {
   "level": "info",
   "title": "部位別ボリューム",
   "body": "胸・肩・背中・脚・お尻・体幹は週10セット未満。減量中は維持目的なら現状維持でも可ですが、筋量を増やしたい部位は週10セット以上を目安に。",
   "sources": [
    "schoenfeld2017vol"
   ]
  },
  {
   "level": "good",
   "title": "日常の歩数は十分",
   "body": "平均8012歩/日。",
   "sources": [
    "paluch2022"
   ]
  },
  {
   "level": "alert",
   "title": "睡眠不足は筋肉を減らす",
   "body": "平均睡眠6.3時間（SOXAI等）。同じ食事制限でも睡眠5.5時間では除脂肪量の減少が60%多くなりました。7時間以上を最優先に。",
   "sources": [
    "nedeltcheva2010"
   ]
  }
 ]
